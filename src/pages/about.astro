---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
const members = await getCollection('members');
---
<Base title={about.data.title} description={about.data.description}>
  <div class="wrap">
    <header class="page-head">
      <span class="label">about</span>
      <h1>{about.data.title}</h1>
    </header>
    <div class="intro">
      <div class="prose"><Content /></div>
      <figure class="blk logo">
        <span class="inst">logo</span>
        <img class="only-light" src="/logo/logo-light.png" alt="PPA Lab 로고. System on Chip Optimization" width="405" height="314" />
        <img class="only-dark" src="/logo/logo-dark.png" alt="PPA Lab 로고. System on Chip Optimization" width="405" height="314" />
      </figure>
    </div>
  </div>

  <section class="sec members" id="members">
    <div class="wrap">
      <div class="sec-head"><h2>Members</h2></div>
      <div class="tbl-wrap">
        <table class="reg">
          <thead><tr><th>Name</th><th>Role</th><th>Interest</th><th>Since</th></tr></thead>
          <tbody>
            {members.map((m) => (
              <tr>
                <td class="name">
                  {m.data.github ? <a href={`https://github.com/${m.data.github}`}>{m.data.name}</a> : m.data.name}
                </td>
                <td>{m.data.role}</td>
                <td><div class="tags">{m.data.interests.map((i) => <span class="tag">{i}</span>)}</div></td>
                <td class="num">{m.data.since ?? '–'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 1fr; gap: var(--s-7); align-items: start; }
  .intro > * { min-width: 0; }
  @media (min-width: 960px) { .intro { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--s-8); } }
  .logo { margin: 0; padding: 28px 24px 24px; max-width: 320px; }
  .logo img { display: block; width: 100%; height: auto; }
  .members { margin-top: var(--s-8); }
  table { min-width: 460px; }
  .name { font-weight: 500; white-space: nowrap; }
</style>
