---
// Award line: a small "수상" chip, the sponsor's mark as a one-colour icon, then the award name.
// logo: path under /public to the sponsor's logo (SVG or transparent PNG). It is drawn in the text colour.
interface Props { name: string; sponsor: string; logo?: string }
const { name, sponsor, logo } = Astro.props;
---
<span class="award">
  <span class="won">수상</span>
  {logo
    ? <span class="mark logo" role="img" aria-label={sponsor} style={`--logo: url(${logo})`}></span>
    : <Fragment set:html={`<svg class="mark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>`} />}
  <span class="txt">{name}{!logo && <span class="sp"> · {sponsor}</span>}</span>
</span>

<style>
  .award { display: inline-flex; align-items: center; gap: 10px; max-width: 100%; color: var(--ink); font-size: var(--fs-small); line-height: 1.4; }
  .won { flex: none; padding: 2px 7px; border-radius: var(--radius-chip); background: var(--signal); color: var(--on-signal); font: 600 12px/1.5 var(--font-body); }
  .award :global(.mark) { flex: none; width: 18px; height: 18px; color: var(--ink-2); }
  .logo { display: inline-block; width: auto; min-width: 18px; aspect-ratio: var(--logo-ratio, 1); background: currentColor; -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
  .sp { color: var(--ink-2); }
</style>
