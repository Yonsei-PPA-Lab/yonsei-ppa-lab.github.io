---
import type { CollectionEntry } from 'astro:content';
import { isoDate } from '../lib/format';

interface Props {
  notes: CollectionEntry<'notes'>[];
}
const { notes } = Astro.props;
---
{notes.length === 0 ? (
  <p class="empty">아직 올라온 노트가 없습니다.</p>
) : (
  <ul class="notes">
    {notes.map((n) => (
      <li>
        <time datetime={isoDate(n.data.date)}>{isoDate(n.data.date)}</time>
        <a href={`/notes/${n.id}/`}>{n.data.title}</a>
        <div class="tags">{n.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </li>
    ))}
  </ul>
)}

<style>
  .notes { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  li { display: grid; grid-template-columns: 1fr; gap: 4px 24px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  li > * { min-width: 0; }
  @media (min-width: 720px) { li { grid-template-columns: 120px 1fr auto; align-items: baseline; } }
  time { font-family: var(--font-mono); font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  a { font-weight: 500; }
</style>
